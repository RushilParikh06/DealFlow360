// B3-owned models (plan.md section 4). Field names below (Category.code,
// Product.categoryId/listPriceMinor/unitCostMinor, Warehouse.code/
// shipmentCostMinor, Inventory.onHand/warehouseId/productId, ProductRelationship.
// sourceProductId/targetProductId/kind/attachRateBps) are load-bearing for B2's
// ops-reader.service.ts and prisma/seed/base.seed.ts - do not rename without
// telling B2.
//
// B2's ops-reader computes available stock from its own inventory_reservations
// ledger (intelligence.prisma), not from Inventory.reserved below. Inventory.
// reserved is this module's own bookkeeping (inventory-state.service.ts) for
// the plain onHand/reserved lifecycle plan.md section 6 describes; the two are
// reconciled at the seam, not merged into one column.

model Category {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

model Product {
  id             String   @id @default(cuid())
  sku            String   @unique
  name           String
  categoryId     String
  listPriceMinor Int
  unitCostMinor  Int
  currency       String   @db.Char(3)
  lineType       LineType @default(ONE_TIME)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       Category         @relation(fields: [categoryId], references: [id])
  variants       ProductVariant[]
  priceListItems PriceListItem[]
  inventory      Inventory[]

  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  sku        String   @unique
  attributes Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("product_variants")
}

/// Ranked upsell/cross-sell pairs, seeded deterministically (README limitations
/// - no learned ranking yet). B2 reads attachRateBps to rank suggestions and
/// blends it with a ceiling-safe discount; ranking logic itself is B2's.
model ProductRelationship {
  id              String   @id @default(cuid())
  sourceProductId String
  targetProductId String
  kind            String   @default("UPSELL")
  attachRateBps   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([sourceProductId, targetProductId, kind])
  @@index([sourceProductId])
  @@map("product_relationships")
}

/// customerTierId is null for the default/general list (plan.md section 4).
/// The tier id itself is a B1-owned foreign id, stored here as a plain string.
model PriceList {
  id             String  @id @default(cuid())
  customerTierId String?
  name           String

  items PriceListItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("price_lists")
}

model PriceListItem {
  id             String    @id @default(cuid())
  priceListId    String
  priceList      PriceList @relation(fields: [priceListId], references: [id])
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  unitPriceMinor Int
  currency       String    @db.Char(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([priceListId, productId])
  @@map("price_list_items")
}

/// categoryId null is the default rate applied when no category-specific rule
/// matches (mirrors discount_policies' null-categoryId convention, B2-owned).
model TaxRule {
  id         String   @id @default(cuid())
  categoryId String?
  rateBps    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tax_rules")
}

model Warehouse {
  id                String   @id @default(cuid())
  code              String   @unique
  name              String
  /// Flat cost of dispatching one shipment from this warehouse, minor units.
  /// The allocation engine tie-breaks on it (allocation.service.ts).
  shipmentCostMinor Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  inventory Inventory[]

  @@map("warehouses")
}

/// available = onHand - reserved, derived, never stored (plan.md section 6).
model Inventory {
  id          String   @id @default(cuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  onHand      Int      @default(0)
  reserved    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([warehouseId, productId])
  @@map("inventory")
}

/// Append-only. Stock is never silently decremented (README) - every change to
/// onHand/reserved is explained by a row here.
model InventoryMovement {
  id          String    @id @default(cuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  delta       Int
  reason      String

  createdAt DateTime @default(now())

  @@map("inventory_movements")
}
