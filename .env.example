# GROUP OWNED (plan.md section 10).
DATABASE_URL="postgresql://dealflow:dealflow@localhost:5432/dealflow?schema=public"
REDIS_URL="redis://localhost:6379"

JWT_SECRET="dev-only-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

API_PORT=3001
API_PREFIX="api/v1"

# dev  = trust x-dev-user-id / x-dev-role headers. Lets B2 test approvals before B1 ships auth.
# jwt  = B1's real guard. Flip to jwt at the first integration checkpoint after auth lands.
AUTH_MODE="dev"

# --- apps/web (Next.js) ---
# Where the browser reaches the NestJS API. Must include the API_PREFIX above.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
# "1" keeps every page on its designed mock rows and never calls the API.
NEXT_PUBLIC_USE_MOCKS="0"
